al izquierda","t":"Sistema circulatorio","i":"Va del lado del pulgar: es el pulso que se toma en la muñeca.","a":168},"69":{"n":"Arteria cubital izquierda","t":"Sistema circulatorio","i":"Va del lado del meñique.","a":178},"70":{"n":"Arco palmar izquierdo","t":"Sistema circulatorio","i":"Une la radial con la cubital y da las arterias de los dedos.","a":21},"71":{"n":"Vena cefálica izquierda","t":"Sistema circulatorio","i":"Vena superficial del lado del pulgar del brazo.","a":485},"72":{"n":"Vena basílica izquierda","t":"Sistema circulatorio","i":"Vena superficial del lado medial del brazo.","a":495},"73":{"n":"Arteria femoral izquierda","t":"Sistema circulatorio","i":"Principal arteria del muslo; su pulso se palpa en la ingle.","a":491},"74":{"n":"Arteria poplítea izquierda","t":"Sistema circulatorio","i":"Pasa por detrás de la rodilla.","a":120},"75":{"n":"Arteria tibial anterior izquierda","t":"Sistema circulatorio","i":"Irriga el frente de la pierna y sigue como pedia en el pie.","a":246},"76":{"n":"Vena femoral izquierda","t":"Sistema circulatorio","i":"Acompaña a la arteria femoral.","a":586},"77":{"n":"Vena safena mayor izquierda","t":"Sistema circulatorio","i":"La vena más larga del cuerpo; se usa en los bypass coronarios.","a":653},"78":{"n":"Arteria axilar derecha","t":"Sistema circulatorio","i":"Continúa a la subclavia por la axila.","a":136},"79":{"n":"Arteria braquial derecha","t":"Sistema circulatorio","i":"Sobre ella se mide la presión arterial.","a":232},"80":{"n":"Arteria radial derecha","t":"Sistema circulatorio","i":"Va del lado del pulgar: es el pulso que se toma en la muñeca.","a":162},"81":{"n":"Arteria cubital derecha","t":"Sistema circulatorio","i":"Va del lado del meñique.","a":168},"82":{"n":"Arco palmar derecho","t":"Sistema circulatorio","i":"Une la radial con la cubital y da las arterias de los dedos.","a":19},"83":{"n":"Vena cefálica derecha","t":"Sistema circulatorio","i":"Vena superficial del lado del pulgar del brazo.","a":492},"84":{